{
  "schemaVersion": 1,
  "ytDlp": {
    "version": "@YT_DLP_VERSION@",
    "layout": "@YT_DLP_LAYOUT@",
    "archiveSha256": "@YT_DLP_SHA256@",
    "executable": "bin/yt-dlp",
    "runtimeDirectory": "@YT_DLP_INSTALLED_RUNTIME_DIRECTORY@"
  },
  "deno": {
    "version": "@DENO_VERSION@",
    "archiveSha256": "@DENO_SHA256@",
    "executable": "bin/deno"
  },
  "runtimeHelpers": [
    "bin/mpv",
    "bin/ffmpeg",
    "bin/ffprobe"
  ],
  "tlsCaBundle": {
    "provider": "certifi",
    "version": "@TLS_CA_VERSION@",
    "sha256": "@TLS_CA_SHA256@",
    "path": "bin/_internal/certifi/cacert.pem"
  }
}
